# Shared secret Meta's connector sends as the X-API-Key header. Generate
# with `openssl rand -hex 24` and put the same value into the connector's
# auth_config.api_key when registering it with Meta (see the plan's
# registration step for the exact POST /agent_connectors request).
CONNECTOR_API_KEY=

# Kartha Hotels MCP endpoint (defaults to the one below if unset)
MCP_URL=https://kartha-hotel.vercel.app/api/mcp

# Shared secret sent to the Kartha MCP as the x-mcp-key header. Set the same
# value as MCP_API_KEY on the Kartha-Hotel Vercel project. Leave empty while
# Kartha's check is switched off.
MCP_API_KEY=

# Upstash Redis REST credentials (console.upstash.com — Redis, not the
# deprecated Vercel KV product). Used for reservation records, idempotency,
# and the demo saved-card cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe TEST-mode secret key for the synchronous payment step (Stripe
# dashboard → Developers → API keys, with "Test mode" on). Must start with
# sk_test_ — the app refuses live keys.
STRIPE_SECRET_KEY=
