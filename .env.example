# Shared secret Meta's connector sends as the X-API-Key header. Generate
# with `openssl rand -hex 24` and put the same value into the connector's
# auth_config.api_key when registering it with Meta (see the plan's
# registration step for the exact POST /agent_connectors request).
CONNECTOR_API_KEY=

# Devara Hotels MCP endpoint (defaults to the production one below if unset)
MCP_URL=https://devara-hotel-site.vercel.app/api/mcp

# Upstash Redis REST credentials (console.upstash.com — Redis, not the
# deprecated Vercel KV product). Used for reservation records, idempotency,
# and the demo saved-card cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe TEST-mode secret key for the synchronous payment step (Stripe
# dashboard → Developers → API keys, with "Test mode" on). Must start with
# sk_test_ — the app refuses live keys.
STRIPE_SECRET_KEY=

# Payment-link flow (branch payment-link) ---------------------------------
# Public origin of this deployment, used for Stripe success/cancel URLs.
PUBLIC_BASE_URL=
# Signing secret of the Stripe webhook endpoint (whsec_...) for /api/stripe-webhook.
STRIPE_WEBHOOK_SECRET=
# WhatsApp Cloud API: sends the post-payment confirmation, then releases the chat
# back to the Meta agent. Token needs whatsapp_business_messaging. Optional: if
# unset, the booking still completes and the agent confirms via the status tool.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
